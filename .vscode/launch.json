{
  // F5 로 실행. "debug type 'debugpy' is not supported" 가 나오면 '(구버전 Python 확장)' 항목을 고르세요.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "To do list",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/todo_list.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "To do list (구버전 Python 확장)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/todo_list.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
